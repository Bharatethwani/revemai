{
  "rewrites": [
    {
      "source": "/supabase/:path*",
      "destination": "https://iwhxyqczdfapprigyrpr.supabase.co/:path*"
    },

    // 1. r.revmeai.com → review/index.html (don't touch this)
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "^r\\.revmeai\\.com$" }
      ],
      "destination": "/review/index.html"
    },

    // 2. ANY other subdomain (like tech.revmeai.com) → template/index.html
    // This handles root + all paths cleanly
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "^[^.]+\\.revmeai\\.com$" }
      ],
      "destination": "/template/index.html"
    },

    // 3. Fallback for main domain (revmeai.com without subdomain)
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
