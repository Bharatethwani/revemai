{
  "rewrites": [
    {
      "source": "/supabase/:path*",
      "destination": "https://iwhxyqczdfapprigyrpr.supabase.co/:path*"
    },

    // 1. r.revmeai.com → review (untouched)
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "^r\\.revmeai\\.com$" }
      ],
      "destination": "/review/index.html"
    },

    // 2. ALL other subdomains (tech.revmeai.com, etc.) → template
    // We use two rules: one for root exactly, one for everything else
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "^[^.]+\\.revmeai\\.com$" }
      ],
      "destination": "/template/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "^[^.]+\\.revmeai\\.com$" }
      ],
      "destination": "/template/index.html"
    },

    // 3. Main domain fallback
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
